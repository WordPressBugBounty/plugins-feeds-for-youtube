#: inc/Builder/SBY_Feed_Builder.php:172
#: vendor/smashballoon/customizer/app/Feed_Builder.php:320
msgid "Legacy feeds represent shortcodes of old feeds found on your website before <br/>the version 6 update."
msgstr "Verouderde feeds zijn shortcodes van oude feeds die op je site stonden vóór <br/>de versie 6 update."

#: inc/Builder/SBY_Feed_Builder.php:173
#: vendor/smashballoon/customizer/app/Feed_Builder.php:321
msgid "To edit Legacy feed settings, you will need to use the \"Settings\" button above <br/>or edit their shortcode settings directly. To delete them, simply remove the <br/>shortcode wherever it is being used on your site."
msgstr "Om de instellingen van de verouderde feed te bewerken, moet je de knop \"Instellingen\" hierboven gebruiken <br/>of hun shortcode instellingen direct bewerken. Om ze te verwijderen, verwijder je gewoon de <br/>shortcode waar die ook gebruikt wordt op je site."

