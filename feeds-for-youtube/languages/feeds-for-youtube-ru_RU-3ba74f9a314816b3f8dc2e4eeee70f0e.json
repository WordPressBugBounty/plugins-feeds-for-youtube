b\u0435\u043d\u0442\u0430 \u043d\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442? "],"Try Re-authenticating connected account":["\u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u0443\u044e \u0430\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u043e\u0439 \u0443\u0447\u0435\u0442\u043d\u043e\u0439 \u0437\u0430\u043f\u0438\u0441\u0438"],"API Key":["\u041a\u043b\u044e\u0447 API"],"Preserve settings if plugin is removed":["\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u043f\u0440\u0438 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0438 \u043f\u043b\u0430\u0433\u0438\u043d\u0430"],"This will make sure that all of your feeds and settings are still saved even if the plugin is uninstalled":["\u042d\u0442\u043e \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0443\u0435\u0442 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u0432\u0441\u0435\u0445 \u0432\u0430\u0448\u0438\u0445 \u043b\u0435\u043d\u0442 \u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u0434\u0430\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u0433\u0438\u043d\u0430"],"Import Feed Settings":["\u0418\u043c\u043f\u043e\u0440\u0442 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u043b\u0435\u043d\u0442\u044b"],"You will need a JSON file previously exported from the Feeds for YouTube Plugin":["\u041f\u043e\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0444\u0430\u0439\u043b JSON, \u0440\u0430\u043d\u0435\u0435 \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0438\u0437 \u043f\u043b\u0430\u0433\u0438\u043d\u0430 Feeds for YouTube"],"Export Feed Settings":["\u042d\u043a\u0441\u043f\u043e\u0440\u0442 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u043b\u0435\u043d\u0442\u044b"],"Select Feed":["\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043b\u0435\u043d\u0442\u0443"],"Export":["\u042d\u043a\u0441\u043f\u043e\u0440\u0442"],"Export settings for one or more of your feeds":["\u042d\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u0443\u0439\u0442\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0434\u043b\u044f \u043e\u0434\u043d\u043e\u0439 \u0438\u043b\u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u0445 \u043b\u0435\u043d\u0442"],"Custom Code":["\u0421\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043a\u043e\u0434"],"Caching":["\u041a\u0435\u0448\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435"],"1:00":["1:00"],"2:00":["2:00"],"3:00":["3:00"],"4:00":["4:00"],"5:00":["5:00"],"6:00":["6:00"],"7:00":["7:00"],"8:00":["8:00"],"9:00":["9:00"],"10:00":["10:00"],"11:00":["11:00"],"12:00":["12:00"],"Cache cleared successfully.":["\u041a\u044d\u0448 \u043e\u0447\u0438\u0449\u0435\u043d."],"Couldn't clear the cache.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u044c \u043a\u044d\u0448."],"Clear All Caches":["\u041e\u0447\u0438\u0441\u0442\u0438\u0442\u044c \u043a\u044d\u0448 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e"],"Used for showing views. Example: 392k views":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u0432. \u041f\u0440\u0438\u043c\u0435\u0440: 392 \u0442\u044b\u0441. \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u0432"],"Ago":["\u041d\u0430\u0437\u0430\u0434"],"Used for showing time. Example: 3d ago":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0432\u0440\u0435\u043c\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f. \u041f\u0440\u0438\u043c\u0435\u0440: 3 \u0434\u043d\u044f \u043d\u0430\u0437\u0430\u0434"],"Used to highlight when a video is streaming live":["\u0423\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u043a\u043e\u0433\u0434\u0430 \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u044f\u043c\u043e\u0439 \u044d\u0444\u0438\u0440"],"Used to highlight when a video is going to stream live":["\u0423\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442, \u0447\u0435\u0440\u0435\u0437 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0430\u0447\u043d\u0435\u0442\u0441\u044f \u043f\u0440\u044f\u043c\u043e\u0439 \u044d\u0444\u0438\u0440"],"Used to show length of the video. Example: 3 minutes 21 seconds":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0432\u0438\u0434\u0435\u043e. \u041f\u0440\u0438\u043c\u0435\u0440: 3 \u043c\u0438\u043d\u0443\u0442\u044b 21 \u0441\u0435\u043a\u0443\u043d\u0434\u0430"],"Used to show length of the video. Example: 1 hour 3 minutes":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0432\u0438\u0434\u0435\u043e. \u041f\u0440\u0438\u043c\u0435\u0440: 1 \u0447\u0430\u0441 3 \u043c\u0438\u043d\u0443\u0442\u044b"],"To display the call to action":["\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043f\u0440\u0438\u0437\u044b\u0432 \u043a \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044e"],"Thousands":["\u0422\u044b\u0441\u044f\u0447\u0438"],"Used in the number of views. Example: 321K videos":["\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0438 \u0447\u0438\u0441\u043b\u0430 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u0432. \u041f\u0440\u0438\u043c\u0435\u0440: 321 \u0442\u044b\u0441. \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u0432"],"Millions":["\u041c\u0438\u043b\u043b\u0438\u043e\u043d\u044b"],"Used in the number of views. Example: 4.2M videos":["\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u0438 \u0447\u0438\u0441\u043b\u0430 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u0432. \u041f\u0440\u0438\u043c\u0435\u0440: 4,2 \u043c\u043b\u043d \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u0432"],"Custom Text\/Translate":["\u041f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442 \/ \u043f\u0435\u0440\u0435\u0432\u043e\u0434"],"Enter custom text for the words below, or translate it into the language you would like to use.":["\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442 \u0434\u043b\u044f \u0441\u043b\u043e\u0432 \u043d\u0438\u0436\u0435 \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u0445 \u043d\u0430 \u044f\u0437\u044b\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b \u0445\u043e\u0442\u0438\u0442\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c."],"Original Text":["\u0418\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442"],"Custom text\/translation":["\u041f\u0440\u043e\u0438\u0437\u0432\u043e\u043b\u044c\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442 \/ \u043f\u0435\u0440\u0435\u0432\u043e\u0434"],"Context":["\u041a\u043e\u043d\u0442\u0435\u043a\u0441\u0442"],"AJAX theme loading fix":["\u041a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u200b\u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u0442\u0435\u043c\u044b AJAX"],"Usage Tracking":["\u041e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f"],"Cron Clear Cache":["Cron \u00ab\u041e\u0447\u0438\u0441\u0442\u0438\u0442\u044c \u043a\u044d\u0448\u00bb"],"If your YouTube feed is not updating, your WordPress installation may have a rare issue with clearing temporary data in your database. Enable this setting to use WordPress cron to clear your feed caches.":["\u0415\u0441\u043b\u0438 \u0432\u0430\u0448\u0430 \u043b\u0435\u043d\u0442\u0430 YouTube \u043d\u0435 \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0435\u0442\u0441\u044f, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0434\u0435\u043b\u043e \u0432 \u0440\u0435\u0434\u043a\u043e\u0439 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0435 \u0441 \u043e\u0447\u0438\u0441\u0442\u043a\u043e\u0439 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0434\u0430\u043d\u043d\u044b\u0445 \u0432 \u0432\u0430\u0448\u0435\u0439 \u0431\u0430\u0437\u0435 \u0434\u0430\u043d\u043d\u044b\u0445 WordPress. \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u044d\u0442\u043e\u0442 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0444\u0443\u043d\u043a\u0446\u0438\u044e cron WordPress \u0434\u043b\u044f \u043e\u0447\u0438\u0441\u0442\u043a\u0438 \u043a\u044d\u0448\u0430 \u043b\u0435\u043d\u0442\u044b."],"Enqueue JavaScript in header":["\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c JavaScript \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u044c \u0432 \u0448\u0430\u043f\u043a\u0443"],"Add the JavaScript file for the plugin in the header instead of the footer":["\u0424\u0430\u0439\u043b Javascript \u0434\u043b\u044f \u043f\u043b\u0430\u0433\u0438\u043d\u0430 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432 \u0448\u0430\u043f\u043a\u0443, \u0430 \u043d\u0435 \u0432 \u043d\u0438\u0436\u043d\u0438\u0439 \u043a\u043e\u043b\u043e\u043d\u0442\u0438\u0442\u0443\u043b"],"Disable WP Posts":["\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438 WP"],"This will disable the feature that saves each video as a WordPress post.":["\u0411\u0443\u0434\u0435\u0442 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0430 \u0444\u0443\u043d\u043a\u0446\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u043a\u0430\u0436\u0434\u043e\u0435 \u0432\u0438\u0434\u0435\u043e \u043a\u0430\u043a \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u044e WordPress."],"Save new videos as":["\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c \u043d\u043e\u0432\u044b\u0435 \u0432\u0438\u0434\u0435\u043e \u043a\u0430\u043a"],"Draft":["\u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a"],"Publish":["\u041e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u0442\u044c"],"When you import new videos, they will be saved accordingly":["\u041f\u0440\u0438 \u0438\u043c\u043f\u043e\u0440\u0442\u0435 \u043d\u043e\u0432\u044b\u0445 \u0432\u0438\u0434\u0435\u043e \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c\u0441\u044f \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c"],"Information to Display":["\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u0434\u043b\u044f \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f"],"Stats (Like and Comment Count)":["\u0421\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 (\u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043b\u0430\u0439\u043a\u043e\u0432 \u0438 \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0435\u0432)"],"Saved Featured Images":["\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0435 \u0438\u0437\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f"],"Enabling this feature will automatically download video thumbnails and assign them as the featured image for a video post created using YouTube Feeds. Image files are stored in your WordPress media library.":["\u041f\u0440\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u044d\u0442\u043e\u0439 \u0444\u0443\u043d\u043a\u0446\u0438\u0438 \u043c\u0438\u043d\u0438\u0430\u0442\u044e\u0440\u044b \u0432\u0438\u0434\u0435\u043e \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u044e\u0442\u0441\u044f \u0438 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0442\u0441\u044f \u0438\u0437\u0431\u0440\u0430\u043d\u043d\u044b\u043c\u0438 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u043c\u0438 \u0434\u043b\u044f \u0432\u0438\u0434\u0435\u043e\u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438, \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u0439 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e YouTube Feeds. \u0424\u0430\u0439\u043b\u044b \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439 \u0445\u0440\u0430\u043d\u044f\u0442\u0441\u044f \u0432 \u0432\u0430\u0448\u0435\u0439 \u043c\u0435\u0434\u0438\u0430\u0442\u0435\u043a\u0435 WordPress."],"Smash Balloon Team":["\u041a\u043e\u043c\u0430\u043d\u0434\u0430 Smash Balloon"],"At Smash Balloon, we build software that helps you create beautiful responsive social media feeds for your website in minutes.":["\u0412 Smash Balloon \u043c\u044b \u0441\u043e\u0437\u0434\u0430\u0435\u043c \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043d\u043e\u0435 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0432\u0441\u0435\u0433\u043e \u0437\u0430 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043c\u0438\u043d\u0443\u0442 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u043a\u0440\u0430\u0441\u0438\u0432\u044b\u0435 \u043e\u0442\u0437\u044b\u0432\u0447\u0438\u0432\u044b\u0435 \u043b\u0435\u043d\u0442\u044b \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0435\u0442\u0435\u0439 \u0434\u043b\u044f \u0432\u0430\u0448\u0438\u0445 \u0432\u0435\u0431-\u0441\u0430\u0439\u0442\u043e\u0432."],"We're on a mission to make it super simple to add social media feeds in WordPress. No more complicated setup steps, ugly iframe widgets, or negative page speed scores.":["\u041d\u0430\u0448\u0430 \u0446\u0435\u043b\u044c \u2014 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043b\u0435\u043d\u0442 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0435\u0442\u0435\u0439 \u0432 WordPress \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u043f\u0440\u043e\u0441\u0442\u044b\u043c. \u0411\u043e\u043b\u044c\u0448\u0435 \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0441\u043b\u043e\u0436\u043d\u044b\u0445 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a, \u0443\u0440\u043e\u0434\u043b\u0438\u0432\u044b\u0445 \u0432\u0438\u0434\u0436\u0435\u0442\u043e\u0432 iframe \u0438\u043b\u0438 \u043e\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439 \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b."],"Our plugins aren't just easy to use, but completely customizable, reliable, and fast! Which is why over 1.6 million awesome users, just like you, choose to use them on their site.":["\u041d\u0430\u0448\u0438 \u043f\u043b\u0430\u0433\u0438\u043d\u044b \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u043e \u0443\u0434\u043e\u0431\u043d\u044b \u0432 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438 \u2014 \u0438\u0445 \u043b\u0435\u0433\u043a\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u043f\u043e\u0434 \u0441\u0435\u0431\u044f, \u043e\u043d\u0438 \u043d\u0430\u0434\u0435\u0436\u043d\u044b\u0435 \u0438 \u0431\u044b\u0441\u0442\u0440\u044b\u0435! \u0412\u043e\u0442 \u043f\u043e\u0447\u0435\u043c\u0443 \u0443\u0436\u0435 \u0431\u043e\u043b\u0435\u0435 1,6 \u043c\u0438\u043b\u043b\u0438\u043e\u043d\u0430 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439, \u0442\u043e\u0447\u043d\u043e \u0442\u0430\u043a\u0438\u0445 \u0436\u0435, \u043a\u0430\u043a \u0438 \u0432\u044b, \u043f\u0440\u0435\u0434\u043f\u043e\u0447\u0438\u0442\u0430\u044e\u0442 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0442\u044c \u044d\u0442\u0438 \u043f\u043b\u0430\u0433\u0438\u043d\u044b \u043d\u0430 \u0441\u0432\u043e\u0438\u0445 \u0441\u0430\u0439\u0442\u0430\u0445."],"Our Other Social Media Feed Plugins":["\u0414\u0440\u0443\u0433\u0438\u0435 \u043d\u0430\u0448\u0438 \u043f\u043b\u0430\u0433\u0438\u043d\u044b \u0434\u043b\u044f \u043b\u0435\u043d\u0442 \u0441\u043e\u0446\u0441\u0435\u0442\u0435\u0439"],"Plugins we recommend":["\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u044b\u0435 \u043f\u043b\u0430\u0433\u0438\u043d\u044b"],"Search Documentation":["\u041f\u043e\u0438\u0441\u043a \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438"],"Need more support? We\u2019re here to help.":["\u041d\u0443\u0436\u043d\u0430 \u043f\u043e\u043c\u043e\u0449\u044c? \u041d\u0430\u0448\u0430 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u044f\u0434\u043e\u043c."],"Submit a Support Ticket":["\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0437\u0430\u044f\u0432\u043a\u0443 \u0432 \u0441\u043b\u0443\u0436\u0431\u0443 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438"],"Our fast and friendly support team is always happy to help!":["\u041d\u0430\u0448\u0430 \u043a\u043e\u043c\u0430\u043d\u0434\u0430 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0434\u0430 \u043f\u043e\u043c\u043e\u0447\u044c!"],"System Info":["\u0421\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e \u0441\u0438\u0441\u0442\u0435\u043c\u0435"],"Collapse":["\u0421\u0432\u0435\u0440\u043d\u0443\u0442\u044c"],"Expand":["\u0420\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044c"],"Export Settings":["\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0430"],"Share your plugin settings easily with Support":["\u041e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0441\u043b\u0443\u0436\u0431\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 \u043f\u043b\u0430\u0433\u0438\u043d\u0430"],"Getting Started":["\u041d\u0430\u0447\u0430\u043b\u043e \u0440\u0430\u0431\u043e\u0442\u044b"],"Some helpful resources to get you started":["\u0420\u044f\u0434 \u043f\u043e\u043b\u0435\u0437\u043d\u044b\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432 \u0434\u043b\u044f \u043d\u0430\u0447\u0430\u043b\u0430 \u0440\u0430\u0431\u043e\u0442\u044b"],"More help getting started":["\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043f\u043e\u043c\u043e\u0449\u044c \u043f\u043e \u043d\u0430\u0447\u0430\u043b\u0443 \u0440\u0430\u0431\u043e\u0442\u044b"],"Docs & Troubleshooting":["\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0438 \u0443\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043d\u0435\u043f\u043e\u043b\u0430\u0434\u043e\u043a"],"Run into an issue? Check out our help docs.":["\u0412\u043e\u0437\u043d\u0438\u043a\u043b\u0438 \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u044b? \u041e\u0437\u043d\u0430\u043a\u043e\u043c\u044c\u0442\u0435\u0441\u044c \u0441 \u043d\u0430\u0448\u0435\u0439 \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u043e\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0435\u0439."],"View Documentation":["\u0421\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u044e"],"Additional Resources":["\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044b"],"To help you get the most out of the plugin":["\u0414\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u043e\u043b\u044c\u0437\u044b \u043e\u0442 \u043f\u043b\u0430\u0433\u0438\u043d\u0430"],"View Blog":["\u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u0432 \u0431\u043b\u043e\u0433"],"Creating Your First YouTube Feed":[""],"How do I Find a Channel ID?":[""],"Guide to Creating and Using an API Key":[""],"How do I Embed a Feed Into a Template Directly?":[""],"My Feed is Showing Unlisted Videos":[""],"Can I Change When the Video Plays?":[""],"How Does the Plugin Optimize Page Load Time?":[""],"Troubleshooting 'YouTube Data API has not been used in project'":[""],"Will Feeds For YouTube Work with Caching Plugins?":[""],"Enter or Paste API Key":[""],"Learn more about how to create and add an API Key here":[""],"Connect with an Access Token":[""],"Reviews":[""],"WPChat":[""],"Install WPChat and connect with customers on WhatsApp, Messenger, Telegram & Instagram and more":[""],"WPConsent":[""],"Detect all the plugins that use cookies and sets a consent banner in just a few clicks. Works well with Smash Balloon plugins.":[""],"TikTok":[""],"Convert videos to WordPress posts":[""],"Recheck license":[""],"Congratulations! You have upgraded to Youtube Feed ":[""],"Please update the plugin by clicking the button on the right for changes to take effect":[""],"Update Plugin":[""],"The plugin will be updated to a newer version":[""],"You might want to backup your website before updating the plugin":[""],"Update Anyway":[""],"Entered API Key is invalid. You can double check the API Key or learn more about generating them <a target='_blank' href='https:\/\/smashballoon.com\/youtube-api-key\/?utm_campaign=youtube-pro&utm_source=settings&utm_medium=api-key'>here<\/a>":[""],"API Key is used to fetch from the YouTube API, and is required for several features to work. <a target='_blank' href='https:\/\/smashballoon.com\/youtube-api-key\/?utm_campaign=youtube-pro&utm_source=settings&utm_medium=api-key'>Learn more<\/a>":[""],"No requests will be made to third-party websites. To accommodate this, some features of the plugin will be limited.":[""],"The plugin will function as normal and load videos directly from YouTube.":[""],"detected":[""],"No GDPR consent plugin detected. Install a compatible <a href='https:\/\/smashballoon.com\/doc\/feeds-for-youtube-gdpr-compliance\/?youtube' target='_blank'>GDPR consent plugin<\/a>, or manually enable the setting to display a GDPR compliant version of the feed to all visitors.":[""],"Activate WPConsent":[""],"Install WPConsent":[""],"Activate WPConsent for GDPR":[""],"Install WPConsent for GDPR":[""],"Manage cookie and privacy preference features from a single place. Smash Balloon plugins work great with WPConsent.":[""],"Installing...":[""],"This helps us prevent plugin and theme conflicts by sending a report in the background once per week about your settings and relevant site stats. It does not send sensitive information like access tokens, email addresses, or user info. This will not affect your site performance as well. <a href='https:\/\/smashballoon.com\/youtube-feed\/docs\/usage-tracking\/?utm_campaign=youtube-pro&utm_source=settings&utm_medium=usage-tracking' target='_blank'>Learn More<\/a>":[""],"The default HTML for the feed can be replaced with custom templates added to your theme's folder. Enable this setting to use these templates. See <a href='https:\/\/smashballoon.com\/doc\/guide-to-creating-custom-templates\/?utm_campaign=youtube-pro&utm_source=settings&utm_medium=custom-templates' target='_blank'>this guide<\/a>.":[""],"Setup":[""],"Let us setup your plugin!":[""],"Bring the power of YouTube videos directly to your site! With an easy setup, you'll have your first feed ready to go in minutes.":[""],"Launch the Setup Wizard":[""],"Welcome Image":[""],"Step":[""],"Exit Setup":[""],"1":[""],"Set up YouTube plugin ":[""],"To be able to fetch your YouTube videos we need a YouTube API key or a connected YouTube account.":[""],"Skip this step":[""],"Add API Key":[""],"Create all feed types (playlist and live streams)":[""],"Display video statistics, comments, and more":[""],"Fetch complete video history":[""],"Learn how to get a YouTube API Key":[""],"OR":[""],"Connect a YouTube account":[""],"Display 20+ videos from any channel":[""],"Cannot fetch playlists, live streams etc.":[""],"Cannot display likes and comments":[""],"Cannot filter out private videos":[""],"Connect YouTube Account Manually":[""],"Cannot connect a YouTube account from the plugin? Generate an access token from our website in a click and paste it below.":[""],"Paste Access Token here":[""],"Access Token entered is not valid":[""],"Generate Access Token":[""],"Add an API Key for YouTube":[""],"For optimal performance, reliability, and to use all feed types and features you will want to enter an API key. It is free to create and only takes a few minutes.":[""],"API key entered is not valid":[""],"API Key added successfully!":[""],"Your access token is added and now you should be able to add any YouTube feeds. You can update and delete it from Settings.":[""],"Okay":[""],"2":[""],"Configure features":[""],"YouTube channel feeds":[""],"Create and edit YouTube feeds":[""],"Downtime Prevention":[""],"Automatically prevents any downtime by cleverly using cache storage":[""],"Video player":[""],"Social Feed Collection":[""],"Install Facebook, Twitter, Instagram and TikTok plugins":[""],"Installs Facebook, Twitter, Instagram and TikTok feeds plugins":[""],"Install Reviews Feed and display customer reviews and an overall rating from Google or Yelp.":[""],"Installs Reviews Feed Plugin":[""],"Installs WPChat Plugin":[""],"Pro Features":[""],"Display playlists, live streams and comments":[""],"Show custom playlists, your live streams and video comments":[""],"Show custom end of video action":[""],"Display a customised call to action when a video ends":[""],"Convert Videos to WordPress posts":[""],"Copy all of your videos into WordPress custom posts":[""],"You might also be interested in...":[""],"Enable your favorite features and disable the ones you don\u2019t need":[""],"Install Selected Plugins":[""],"Activate a GDPR plugin":[""],"Install a GDPR plugin":[""],"Ensure your social media feeds comply with privacy regulations by activating a plugin today.":[""],"Ensure your social media feeds comply with privacy regulations by installing a plugin today.":[""],"Activate Selected Plugin":[""],"Install Selected Plugin":[""],"WPConsent activated":[""],"WPConsent installed":[""],"Why should I install a GDPR plugin?":[""],"Legal Compliance":[""],"Ensure your website complies with GDPR and other privacy regulations.":[""],"Build Trust":[""],"Show visitors you respect their privacy with transparent cookie consent.":[""],"Easy Management":[""],"Simplify cookie consent and privacy compliance with automated tools.":[""],"Upgrade to Unlock playlists, livestreams, custom actions and much more":[""],"To unlock these features and much more, upgrade to Pro and enter your license key below.":[""],"Upgrade to YouTube Feed Pro":[""],"Upgrade today and ":[""],"(auto-applied at checkout)":[""],"Awesome. You are all set up!":[""],"Here\u2019s an overview of everything that is setup":[""],"Complete Setup Without Upgrading":[""],"Installing":[""],"We\u2019re more than just an Youtube plugin!":[""],"Check out our other plugins and add more content to your site.":[""]}}}